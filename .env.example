# PeerLink Environment Configuration

# Application Server
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=peerlink_db
DB_USER=root
DB_PASSWORD=

# Session / Authentication Security
JWT_SECRET=peerlink_super_secure_jwt_dev_secret_key_2026
JWT_EXPIRES_IN=7d

# Database Driver Mode (Options: mysql | mock)
# When set to 'mock', an in-memory SQL state initialized with seed data is used.
# This enables running and testing out-of-the-box before MySQL credentials are configured.
DB_CLIENT=mysql
